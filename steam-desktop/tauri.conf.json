{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bio-Foil",
  "version": "1.0.0",
  "identifier": "com.biofoil.roguelike",
  "build": {
    "frontendDist": "./tauri-dist"
  },
  "app": {
    "windows": [
      {
        "title": "BIO-FOIL — Tactical Hydrofoil Roguelike",
        "width": 1600,
        "height": 900,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "targets": ["app", "dmg", "msi", "appimage"]
  }
}
