#!/usr/bin/env sh
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
# B16: herdado de um `node --test` pai, faz o `node --test` do hook sair 0 mesmo com falha (medido em 2026-10-22)
unset NODE_TEST_CONTEXT
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
MAIN_GIT_DIR="$(git rev-parse --git-common-dir)"
case "$MAIN_GIT_DIR" in /*) ;; *) MAIN_GIT_DIR="$REPO_ROOT/$MAIN_GIT_DIR" ;; esac

BARE_VAL="$(git --git-dir="$MAIN_GIT_DIR" config --get core.bare || echo "false")"
if [ "$BARE_VAL" != "false" ]; then
  echo "ERRO FATAL [Secao 5]: core.bare=$BARE_VAL no repositorio principal ($MAIN_GIT_DIR). Pare e reporte sem consertar sozinho." >&2
  exit 1
fi

# B4: testa o que esta COMMITADO em HEAD (o que vai ser enviado), nao a arvore de trabalho
EXPORT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ftl-pre-push.XXXXXX")"
trap 'rm -rf "$EXPORT_DIR"' EXIT
git archive HEAD | tar -x -C "$EXPORT_DIR"

PORTOES="$EXPORT_DIR/padrao/protocolo/PORTOES.md"
ARQUIVOS="$(grep -E '^\| `tests/[^`]+\.test\.mjs` \| OBRIGATORIO \|' "$PORTOES" | sed -E 's/^\| `([^`]+)`.*/\1/' || true)"
QTD="$(printf '%s\n' "$ARQUIVOS" | grep -c . || true)"
echo "[N4] Portoes obrigatorios examinados no pre-push: $QTD"
if [ "$QTD" -eq 0 ]; then
  echo "ERRO FATAL [Lei N4]: zero portoes obrigatorios examinados." >&2
  exit 1
fi

cd "$EXPORT_DIR"
# shellcheck disable=SC2086
env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX -u GIT_COMMON_DIR -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
  node --test $ARQUIVOS

BARE_AFTER="$(git --git-dir="$MAIN_GIT_DIR" config --get core.bare || echo "false")"
if [ "$BARE_AFTER" != "false" ]; then
  echo "ERRO FATAL POS-TESTE [Secao 5]: core.bare=$BARE_AFTER no repositorio principal apos rodar testes." >&2
  exit 1
fi
